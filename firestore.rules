rules_version = '2';

// LWG Team Tool — Firestore security rules (v3: reads are team-private)
// ======================================================================
// Paste into Firebase console > Firestore Database > Rules > Publish
// (project: champ-pool-lwg).
//
// One-time console setup this version depends on:
//   Authentication > Sign-in method > Google > Enable          (people)
//   Authentication > Sign-in method > Email/Password > Enable  (the CLI bot)
//
// v3 closes READS as well as writes: champion pools, tier ratings, and
// strategy notes are competitive intelligence — an opposing team reading
// them is as bad as a vandal editing them. Nothing about this tool needs a
// public audience. Access = the admin, the allowlist the admin manages
// from the app's Team tab, or the strategy CLI's dedicated bot account
// (pinned by uid, so a stranger signing up an account can never claim it).
//
// CLI_BOT_UID: replace the placeholder with the bot's real uid once the
// account exists — until then the CLI simply stays locked out; nothing
// else is affected.

service cloud.firestore {
  match /databases/{database}/documents {

    // Fixed here, not in data, so a compromised allowlist can never mint a
    // new admin. Must match ADMIN_EMAIL in app.js.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'duskliberty@gmail.com';
    }

    // The strategy CLI's bot account. uid, not email: email/password
    // accounts are never email-verified, and anyone can sign UP an email —
    // but a uid belongs to exactly one existing account.
    function isCli() {
      return request.auth != null
        && request.auth.uid == 'CLI_BOT_UID_PENDING';
    }

    function isTeam() {
      return isAdmin()
        || isCli()
        || (request.auth != null
            && request.auth.token.email_verified == true
            && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email)));
    }

    // Only the admin can see or change who is on the list.
    match /allowlist/{email} {
      allow read, write: if isAdmin();
    }

    match /notes/{noteId} {
      allow read, write: if isTeam();
    }

    match /people/{personId} {
      allow read, write: if isTeam();
    }

    match /events/{eventId} {
      allow read, write: if isTeam();
    }

    match /teamComps/{compId} {
      allow read, write: if isTeam();
    }

    // Custom-game logging is paused (Riot LCU policy question). When it
    // resumes, the logger runs on players' machines and will need its own
    // credential or a shape-checked create — decide then, not pre-opened now.
    match /customGames/{gameId} {
      allow read, write: if isTeam();
    }

    match /draftState/{docId} {
      allow read, write: if isTeam();
    }

    // A collection not named above cannot be touched at all.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
